# Network
HOST=0.0.0.0
PORT=8000
# Set this in production. Clients send: Authorization: Bearer <value>
API_KEY=
CORS_ORIGINS=*

# Speech-to-text: faster-whisper model name or a local model directory
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Chat: uses the same Ollama default as ../web-chat and reads ../knowledge_rules.json before each answer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dq-assistant:latest
OLLAMA_TIMEOUT_SECONDS=120

# Semantic RAG (Qdrant + a locally served Ollama embedding model). Leave 0 to use keyword rules.
RAG_ENABLED=0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=local_ai_knowledge
OLLAMA_EMBED_MODEL=embeddinggemma
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CHARS=9000

# Text-to-speech
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
MAX_AUDIO_BYTES=26214400
MAX_HISTORY_MESSAGES=12
WHISPER_BEAM_SIZE=1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
WARMUP_ON_START=1
OLLAMA_KEEP_ALIVE=30m
HF_HUB_OFFLINE=0
