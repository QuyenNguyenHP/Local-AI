# Network
HOST=0.0.0.0
PORT=8000
# Set this in production. Clients send: Authorization: Bearer <value>
API_KEY=
CORS_ORIGINS=*

# Speech-to-text: faster-whisper model name or a local model directory
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Chat
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=dq-assistant:latest
OLLAMA_TIMEOUT_SECONDS=120

# Semantic RAG (required: Qdrant + a locally served Ollama embedding model)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=local_ai_knowledge
OLLAMA_EMBED_MODEL=embeddinggemma
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CHARS=9000

# Text-to-speech
# Select one backend before starting the server: en (Kokoro-82M) or vi (Kokoro-Vietnamese).
TTS_LANGUAGE=en
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
# auto selects CUDA when available, otherwise CPU. Used only when TTS_LANGUAGE=vi.
KOKORO_VI_DEVICE=auto
MAX_AUDIO_BYTES=26214400
# Maximum JPEG, PNG, or WebP upload for POST /v1/images/chat.
MAX_IMAGE_BYTES=10485760
MAX_HISTORY_MESSAGES=12
WHISPER_BEAM_SIZE=1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
WARMUP_ON_START=1
OLLAMA_KEEP_ALIVE=30m
HF_HUB_OFFLINE=0

# Optional Home Assistant tool. Leave HA_ENABLED=0 until this is configured.
# Never commit HA_TOKEN; create a dedicated long-lived HA token with minimum access.
HA_ENABLED=0
HA_URL=https://home.example.com
HA_TOKEN=
# Comma-separated allowlist. The model cannot control any entity outside it.
HA_ALLOWED_ENTITIES=switch.example_light
HA_TIMEOUT_SECONDS=10
