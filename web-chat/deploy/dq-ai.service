[Unit]
Description=DQ AI local Ollama chat web app
After=network.target ollama.service

[Service]
Type=simple
User=dq
Group=dq
WorkingDirectory=/home/dq/Local AI/web-chat
Environment=NODE_ENV=production
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=dq-assistant:latest
Environment=PORT=3001
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
